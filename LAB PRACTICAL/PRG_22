#include <stdio.h>

int main()
{
    int block[20], process[20];
    int b, p, i, j, best;

    printf("Enter the number of memory blocks: ");
    scanf("%d", &b);

    printf("Enter the sizes of memory blocks:\n");
    for(i = 0; i < b; i++)
        scanf("%d", &block[i]);

    printf("Enter the number of processes: ");
    scanf("%d", &p);

    printf("Enter the sizes of processes:\n");
    for(i = 0; i < p; i++)
        scanf("%d", &process[i]);

    printf("\nProcess\tProcess Size\tBlock Allocated\n");

    for(i = 0; i < p; i++)
    {
        best = -1;

        for(j = 0; j < b; j++)
        {
            if(block[j] >= process[i])
            {
                if(best == -1 || block[j] < block[best])
                    best = j;
            }
        }

        if(best != -1)
        {
            printf("P%d\t%d\t\t%d\n", i + 1, process[i], best + 1);
            block[best] = block[best] - process[i];
        }
        else
        {
            printf("P%d\t%d\t\tNot Allocated\n", i + 1, process[i]);
        }
    }

    return 0;
}
