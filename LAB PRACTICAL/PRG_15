#include<stdio.h>
#include<string.h>
int main()
{
    char user[10][20],file[10][20],u[20],f[20];
    int n,i;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%s%s",user[i],file[i]);

    scanf("%s%s",u,f);

    for(i=0;i<n;i++)
        if(strcmp(user[i],u)==0 && strcmp(file[i],f)==0)
        {
            printf("File Found");
            return 0;
        }

    printf("File Not Found");
    return 0;
}
