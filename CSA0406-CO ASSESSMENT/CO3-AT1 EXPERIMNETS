3.PAGE TABLE SIMULATION
#include<stdio.h>
int main()
{
    int pt[3],i,p,o;
    for(i=0;i<3;i++)
        scanf("%d",&pt[i]);
    scanf("%d%d",&p,&o);
    printf("Frame = %d\n",pt[p]);
    printf("Physical Address = %d",pt[p]*100+o);
    return 0;
}
OUTPUT:
5 2 7
1
30
Frame = 2
Physical Address = 230
4.TRANSLATION LOOKASIDE BUFFER(TLB)
#include<stdio.h>
int main()
{
    float m,t,h;
    scanf("%f%f%f",&m,&t,&h);
    printf("Without TLB = %.0f\n",2*m);
    printf("With TLB = %.0f",h*(t+m)+(1-h)*(t+2*m));
    return 0;
}
OUTPUT:
100
20
0.8
Without TLB = 200
With TLB = 140
