int contiguous(int disk[], int n, int size, int blocks[]) {
    int i, j, count;

    for (i = 0; i <= n - size; i++) {
        count = 0;

        for (j = i; j < i + size; j++) {
            if (disk[j] == 0)
                count++;
            else
                break;
        }

        if (count == size) {
            for (j = 0; j < size; j++) {
                blocks[j] = i + j;
                disk[i + j] = 1;
            }
            return 1;
        }
    }

    return 0;
}

int indexed(int disk[], int n, int size, int blocks[]) {
    int i, count = 0;

    for (i = 0; i < n; i++) {
        if (disk[i] == 0) {
            disk[i] = 1;
            break;
        }
    }

    if (i == n)
        return 0;

    for (i = 0; i < n && count < size; i++) {
        if (disk[i] == 0) {
            disk[i] = 1;
            blocks[count++] = i;
        }
    }

    return count == size;
}

int FCFS(int blocks[], int n, int head) {
