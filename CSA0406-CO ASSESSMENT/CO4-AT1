    for (i = 0; i < n; i++) {
        total += abs(head - blocks[i]);
        head = blocks[i];
        printf("-> %d ", head);
    }

    return total;
}

int SSTF(int blocks[], int n, int head) {
    int visited[100] = {0};
    int i, j, min, index;
    int total = 0;

    printf("SSTF: %d ", head);

    for (i = 0; i < n; i++) {
        min = 9999;
