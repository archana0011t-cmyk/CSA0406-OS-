void FCFS(int req[], int n, int head) {
    int i, total = 0, current = head;

    printf("\nFCFS: %d ", head);

    for (i = 0; i < n; i++) {
        total += abs(current - req[i]);
        current = req[i];
        printf("-> %d ", current);
    }

    printf("\nTotal Seek Time = %d\n", total);
}

void SSTF(int req[], int n, int head) {
    int visited[100] = {0};
    int i, j, min, index;
    int total = 0, current = head;

    printf("\nSSTF: %d ", head);

    for (i = 0; i < n; i++) {
        min = 9999;
        index = -1;

        for (j = 0; j < n; j++) {
            if (!visited[j] &&
                abs(current - req[j]) < min) {
                min = abs(current - req[j]);
                index = j;
            }
        }

        visited[index] = 1;
        total += min;
        current = req[index];

        printf("-> %d ", current);
    }

    printf("\nTotal Seek Time = %d\n", total);
}

void SCAN(int req[], int n, int head, int diskSize) {
    int a[100], i, j, total = 0;
    int current = head;

    for (i = 0; i < n; i++)
        a[i] = req[i];

    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (a[i] > a[j]) {
                int t = a[i];
                a[i] = a[j];
                a[j] = t;
            }
        }
    }

    printf("\nSCAN: %d ", head);

    for (i = 0; i < n; i++) {
        if (a[i] >= head) {
            total += abs(current - a[i]);
            current = a[i];
            printf("-> %d ", current);
        }
    }

    total += abs(current - (diskSize - 1));
    current = diskSize - 1;
    printf("-> %d ", current);

    for (i = n - 1; i >= 0; i--) {
        if (a[i] < head) {
            total += abs(current - a[i]);
            current = a[i];
            printf("-> %d ", current);
        }
    }

    printf("\nTotal Seek Time = %d\n", total);
}

int main() {
    int req[100], n, head, diskSize;
    int i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    FCFS(req, n, head);
    SSTF(req, n, head);
    SCAN(req, n, head, diskSize);

    return 0;
}
